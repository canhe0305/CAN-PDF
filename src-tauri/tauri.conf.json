{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAN PDF",
  "version": "0.1.0",
  "identifier": "app.can.pdf",
  "build": {
    "frontendDist": "../frontend/dist-cans"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CAN PDF",
        "width": 1280,
        "height": 850,
        "decorations": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
